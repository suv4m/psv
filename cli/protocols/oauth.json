{
  "id": "oauth2-pkce",
  "name": "OAuth 2.0 PKCE Flow (RFC 7636)",
  "initialState": "UNAUTHENTICATED",
  "finalStates": ["SESSION_REVOKED", "UNAUTHENTICATED"],
  "states": [
    "UNAUTHENTICATED", "CHALLENGE_GENERATED", "AUTH_CODE_REQUESTED",
    "CONSENT_GRANTED", "CODE_ISSUED", "TOKEN_EXCHANGE",
    "AUTHORIZED_ACTIVE", "TOKEN_REFRESHING", "SESSION_REVOKED"
  ],
  "alphabet": [
    "GEN_CODE_VERIFIER", "REDIRECT_TO_AUTH_SERVER", "USER_APPROVES_CONSENT",
    "USER_DENIES_CONSENT", "RECEIVE_AUTH_CODE", "POST_TOKEN_WITH_VERIFIER",
    "TOKEN_SUCCESS", "TOKEN_INVALID_VERIFIER", "ACCESS_API_RESOURCE",
    "TRIGGER_REFRESH", "REFRESH_SUCCESS", "REFRESH_FAILED", "REVOKE_TOKEN"
  ],
  "transitions": [
    { "from": "UNAUTHENTICATED", "event": "GEN_CODE_VERIFIER", "to": "CHALLENGE_GENERATED" },
    { "from": "CHALLENGE_GENERATED", "event": "REDIRECT_TO_AUTH_SERVER", "to": "AUTH_CODE_REQUESTED" },
    { "from": "AUTH_CODE_REQUESTED", "event": "USER_APPROVES_CONSENT", "to": "CONSENT_GRANTED" },
    { "from": "AUTH_CODE_REQUESTED", "event": "USER_DENIES_CONSENT", "to": "UNAUTHENTICATED" },
    { "from": "CONSENT_GRANTED", "event": "RECEIVE_AUTH_CODE", "to": "CODE_ISSUED" },
    { "from": "CODE_ISSUED", "event": "POST_TOKEN_WITH_VERIFIER", "to": "TOKEN_EXCHANGE" },
    { "from": "TOKEN_EXCHANGE", "event": "TOKEN_SUCCESS", "to": "AUTHORIZED_ACTIVE" },
    { "from": "TOKEN_EXCHANGE", "event": "TOKEN_INVALID_VERIFIER", "to": "UNAUTHENTICATED" },
    { "from": "AUTHORIZED_ACTIVE", "event": "ACCESS_API_RESOURCE", "to": "AUTHORIZED_ACTIVE" },
    { "from": "AUTHORIZED_ACTIVE", "event": "TRIGGER_REFRESH", "to": "TOKEN_REFRESHING" },
    { "from": "TOKEN_REFRESHING", "event": "REFRESH_SUCCESS", "to": "AUTHORIZED_ACTIVE" },
    { "from": "TOKEN_REFRESHING", "event": "REFRESH_FAILED", "to": "UNAUTHENTICATED" },
    { "from": "AUTHORIZED_ACTIVE", "event": "REVOKE_TOKEN", "to": "SESSION_REVOKED" },
    { "from": "SESSION_REVOKED", "event": "GEN_CODE_VERIFIER", "to": "CHALLENGE_GENERATED" }
  ]
}

